{
  "name": "sprintlab",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "verify:performance-time": "node --experimental-strip-types --loader ./scripts/alias-loader.mjs ./scripts/verify-performance-time.ts",
    "verify:planner": "node --experimental-strip-types ./scripts/verify-planner-architecture.ts && node --experimental-strip-types --loader ./scripts/alias-loader.mjs ./scripts/verify-plan-pathways.ts",
    "verify:streaks": "node --experimental-strip-types --loader ./scripts/alias-loader.mjs ./scripts/verify-streaks.ts",
    "verify:ai-context": "node --experimental-strip-types --loader ./scripts/alias-loader.mjs ./scripts/verify-ai-context.ts",
    "verify:ai-plan-change": "node --experimental-strip-types --loader ./scripts/alias-loader.mjs ./scripts/verify-ai-plan-change.ts",
    "verify:coach-proposal": "node --experimental-strip-types --loader ./scripts/alias-loader.mjs ./scripts/verify-coach-proposal.ts",
    "verify:coach-triggers": "node --experimental-strip-types --loader ./scripts/alias-loader.mjs ./scripts/verify-coach-triggers.ts",
    "verify:coach-actions": "node --experimental-strip-types --loader ./scripts/alias-loader.mjs ./scripts/verify-coach-actions.ts",
    "test:coach": "node --experimental-strip-types ./scripts/dev-test-coach.ts",
    "test:coach-context": "node --experimental-strip-types --loader ./scripts/alias-loader.mjs ./scripts/dev-test-coach-context.ts",
    "test:coach-plan-change": "node --experimental-strip-types --loader ./scripts/alias-loader.mjs ./scripts/dev-test-coach-plan-change.ts",
    "test:coach-c2": "node --experimental-strip-types --loader ./scripts/alias-loader.mjs ./scripts/dev-test-coach-c2.ts",
    "knowledge:upload": "node --experimental-strip-types ./scripts/knowledge-upload.ts",
    "knowledge:test": "node --experimental-strip-types ./scripts/knowledge-test.ts"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@google/genai": "^2.17.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-picker/picker": "2.11.1",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "expo": "~54.0.35",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-linking": "~8.0.12",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-updates": "~29.0.20",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-markdown-display": "^7.0.2",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
